{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(./secrets/**)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git commit --no-verify *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(gh release *)",
      "Bash(cosign sign *)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/.golangci.yml)",
      "Edit(/Makefile)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./.golangci.yml)",
      "Edit(./Makefile)",
      "Bash(git push *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker *)",
      "Bash(go get *)",
      "Bash(npm install *)",
      "Bash(gh pr merge *)"
    ],
    "allow": [
      "Bash(make *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go mod tidy)",
      "Bash(gofmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git branch *)",
      "Bash(go list *)",
      "Bash(gh issue list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(python3 .claude/hooks/test_hooks.py)",
      "Bash(python3 .github/scripts/check_rules.py)"
    ],
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "~/cloudvertex/warden"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_branch.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_code.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_go.py"
          }
        ]
      }
    ]
  }
}
